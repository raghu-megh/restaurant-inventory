generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @default("NO_NAME")
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  email         String    @unique(map: "user_email_idx")
  emailVerified DateTime? @db.Timestamp(6)
  password      String?
  role          Role      @default(USER)

  inventoryItems Inventory[]
  transactions   Transaction[]

  @@index([createdAt]) // Optimized user listing queries by creation date
}

model Inventory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  category    Category
  description String?
  price       Decimal? @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  unit        Unit     @default(LBS)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.Uuid

  transactions Transaction[]

  @@index([userId]) // Speeds up queries filtering inventory by user
}

model Transaction {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryItem Inventory       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String          @db.Uuid
  description   String?
  type          TransactionType @default(USAGE)
  quantity      Int
  unit          Unit
  createdAt     DateTime        @default(now()) @db.Timestamp(6)

  itemId String @db.Uuid

  @@index([itemId]) // Speeds up queries filtering by item
  @@index([userId, createdAt]) // Optimized filtering transactions by user and date
  @@index([createdAt]) // Optimized sorting by date
}

enum TransactionType {
  PURCHASE
  USAGE
  WASTAGE
}

enum Unit {
  LBS
  KGS
  LTRS
  GALS
  PIECES
}

enum Category {
  DAIRY
  MEAT
  VEGETABLES
  BEVERAGES
  OTHER
}

enum Role {
  USER
  ADMIN
}
