generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @default("NO_NAME")
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  email         String    @unique(map: "user_email_idx")
  emailVerified DateTime? @db.Timestamp(6)
  password      String?
  role          Role      @default(USER)

  restaurants  Restaurant[]
  transactions Transaction[]

  @@index([email]) // Speeds up user lookup by email
  @@index([createdAt]) // Optimized user listing queries by creation date
}

model Restaurant {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  address      String
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String?       @db.Uuid
  inventory    Inventory[]
  transactions Transaction[]

  @@index([userId]) // Optimized restaurant lookup by user
}

model Inventory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  category    Category
  description String?
  price       Decimal? @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  unit        Unit     @default(LBS)

  transactions Transaction[]
  restaurant   Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String?       @db.Uuid

  @@index([restaurantId]) // Optimized inventory lookup by restaurant
}

model Transaction {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventory   Inventory       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String          @db.Uuid
  description String?
  type        TransactionType @default(USAGE)
  quantity    Int
  unit        Unit
  createdAt   DateTime        @default(now()) @db.Timestamp(6)

  itemId       String      @db.Uuid
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String?     @db.Uuid

  @@index([itemId]) // Speeds up queries filtering by inventory item
  @@index([restaurantId, createdAt]) // Optimized filtering transactions by restaurant and date
  @@index([createdAt]) // Optimized sorting by date
}

enum TransactionType {
  PURCHASE
  USAGE
  WASTAGE
}

enum Unit {
  LBS
  KGS
  LTRS
  GALS
  PIECES
}

enum Category {
  DAIRY
  MEAT
  VEGETABLES
  BEVERAGES
  OTHER
}

enum Role {
  USER
  ADMIN
}
